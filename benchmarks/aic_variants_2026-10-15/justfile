# Run from the lane checkout. Uses the required isolated pinned snapshot.
repo := justfile_directory() / "../.."
export LOCK_SNAP_DIR := env_var("HOME") / "tmp/zenmetrics-lock-snap-aicvariants"

# Each command is serialized against other work on the shared host.
cargo +args:
    cd {{repo}} && flock "$HOME/tmp/i265-heavy.lock" "$HOME/work/claudehints/scripts/run-heavy" --mem 16G -- just snap-cargo @ {{args}}

panel out +metrics:
    cd {{repo}} && flock "$HOME/tmp/i265-heavy.lock" "$HOME/work/claudehints/scripts/run-heavy" --mem 16G -- python3 benchmarks/aic_variants_2026-10-15/panel.py "$LOCK_SNAP_DIR/target/release/zenmetrics" {{out}} {{metrics}}
