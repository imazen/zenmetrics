<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd LaunchDaemon for the Zen macOS fleet worker.
     A LaunchDaemon (in /Library/LaunchDaemons, loaded as root) runs at BOOT, with NO GUI/login
     session, and survives logout and reboot: the macOS analog of the Linux systemd zen-worker
     service and the Windows SYSTEM scheduled task. It is NOT tied to a Docker Desktop login.

     install.sh templates the PAYLOAD_DIR token to the real payload path and copies this into place.
       KeepAlive: relaunch if the pool loop exits (e.g. after a drain, it re-checks for new work).
       Nice 10 + LowPriorityIO: yield to interactive use on a shared machine.
       ThrottleInterval avoids a hot relaunch loop when the pool is fully drained.
     For an IDLE-ONLY worker on a shared desktop, see README "Idle-only" (adds a wake/idle gate). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.imazen.zenworker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PAYLOAD_DIR__/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PAYLOAD_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>300</integer>

    <key>Nice</key>
    <integer>10</integer>
    <key>LowPriorityIO</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>__PAYLOAD_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PAYLOAD_DIR__/launchd.err.log</string>
</dict>
</plist>
