# worker.env.example -- config for a Zen macOS fleet worker.
# Copy to worker.env and fill in. NEVER commit the filled-in worker.env -- it holds R2 credentials.
# The launchd job and run.sh both read this file.

# Scoped R2 credentials. Mint short-TTL, prefix-scoped temp creds on the DEV box with
# `ubuntu-node/mint_cred.sh` (7-day max) -- NEVER put the account root key on a node.
# AWS_SESSION_TOKEN is MANDATORY for temp creds (they 403 on key+secret alone).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=auto

# R2 endpoint + bucket + the shared pool runlist (the SAME job pool the cloud/tower fleet works).
ZEN_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
ZEN_BUCKET=zentrain
ZEN_POOL_RUNLIST=s3://zentrain/jobs/_pool/runlist.tsv

# Worker id on the ledger (default: macpool-<hostname>). Provider tier label for ledger rows.
# ZEN_WORKER=macpool-studio
ZEN_PROVIDER=mac

# CPU budget: worker threads (default = half the logical cores). Lower is gentler on the machine.
# On a shared desktop keep this modest; on a dedicated Mac mini/Studio you can raise it.
ZEN_THREADS=4

# Keep one warm jobexec child per pass (faster; costs a little idle RAM).
ZEN_PERSISTENT_EXEC=1
