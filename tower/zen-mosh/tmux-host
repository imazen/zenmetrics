#!/bin/sh
# Login shell for the zen-mosh gateway container.
#
# Interactive logins (mosh or plain ssh -p 2223) land in the persistent tmux
# session "main"; every pane is a HOST root shell (see /etc/tmux.conf
# default-command -> hostshell). Command execution ("ssh -p 2223 ... 'cmd'")
# also runs on the HOST so the gateway behaves like the real box.
case "$1" in
  -c)
    shift
    case "$1" in
      mosh-server*|*/mosh-server*)
        # mosh bootstrap must exec the CONTAINER's mosh-server; the shell it
        # spawns for the session is tmux-host again -> tmux -> host shells.
        exec /bin/bash -c "$@"
        ;;
      *)
        exec nsenter -t 1 -m -u -i -n -- /bin/bash -c "$@"
        ;;
    esac
    ;;
esac
exec /usr/bin/tmux new-session -A -s main
